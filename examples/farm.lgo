; SUNNY FARM
; Paste this entire file into the text editor and press Run.
; Use a graphics area at least 600 wide and 400 high.
; The last line draws the scene. Run FARM again to redraw it.
; All coordinates are relative to the center of the graphics area.

; Move without leaving a connecting line.
TO FARM.MOVE :X :Y
  PU SETXY :X :Y PD
END

; Rectangle from its lower-left corner.
TO FARM.BOX :X :Y :W :H
  FARM.MOVE :X :Y
  SETH 90
  REPEAT 2 [FD :W LT 90 FD :H LT 90]
END

; Draw a full circle centered on the supplied coordinates.
TO FARM.CIRCLE :X :Y :R
  FARM.MOVE :X :Y
  SETH 0 ARC 360 :R
END

TO FARM.BARN
  SETPC 4 SETPENSIZE 3
  FARM.BOX -210 -65 150 110
  FARM.MOVE -225 45
  SETXY -135 115 SETXY -45 45 SETXY -225 45
  ; Barn siding.
  SETPENSIZE 1
  FARM.MOVE -195 -65 SETH 0
  REPEAT 9 [FD 110 BK 110 PU RT 90 FD 15 LT 90 PD]
  ; Double doors and their diagonal braces.
  SETPC 0 SETPENSIZE 3
  FARM.BOX -170 -65 70 65
  FARM.MOVE -135 -65 SETXY -135 0
  FARM.MOVE -170 -65 SETXY -135 0 SETXY -100 -65
  FARM.MOVE -170 0 SETXY -135 -65 SETXY -100 0
  SETPC 1 FARM.BOX -150 55 30 25
  FARM.MOVE -135 55 SETXY -135 80
END

TO FARM.SILO
  SETPC 8 SETPENSIZE 3
  FARM.BOX -35 -65 55 125
  FARM.MOVE -35 60
  SETXY -28 80 SETXY -8 92 SETXY 13 80 SETXY 20 60
  SETPENSIZE 1
  FARM.MOVE -35 -40 SETH 90
  REPEAT 4 [FD 55 BK 55 PU LT 90 FD 25 RT 90 PD]
END

TO FARM.SUN
  SETPC 14 SETPENSIZE 3
  FARM.CIRCLE 205 125 22
  FARM.MOVE 205 125 SETH 0
  REPEAT 12 [PU FD 29 PD FD 10 PU BK 39 RT 30]
  PD
END

TO FARM.TREE :X :Y
  SETPC 6 SETPENSIZE 5
  FARM.MOVE :X :Y SETH 0 FD 40
  SETPC 2 SETPENSIZE 3
  FARM.CIRCLE :X :Y + 57 23
  FARM.CIRCLE :X - 17 :Y + 43 19
  FARM.CIRCLE :X + 17 :Y + 43 19
END

TO FARM.TRACTOR
  SETPC 2 SETPENSIZE 4
  FARM.BOX 75 -70 110 30
  FARM.BOX 85 -40 43 45
  FARM.MOVE 78 8 SETXY 135 8
  SETPC 1 SETPENSIZE 2 FARM.BOX 92 -33 28 31
  SETPC 0 SETPENSIZE 4
  FARM.MOVE 165 -40 SETXY 165 -14 SETXY 173 -14
  FARM.CIRCLE 100 -75 24
  FARM.CIRCLE 174 -80 17
  SETPC 8 SETPENSIZE 2
  FARM.CIRCLE 100 -75 10
  FARM.CIRCLE 174 -80 7
  ; Front grille.
  FARM.MOVE 178 -45 SETH 180
  REPEAT 3 [FD 19 BK 19 PU RT 90 FD 5 LT 90 PD]
END

TO FARM.FENCE
  SETPC 6 SETPENSIZE 3
  FARM.MOVE -255 -110 SETXY -35 -110
  FARM.MOVE -255 -127 SETXY -35 -127
  FARM.MOVE -250 -140 SETH 0
  REPEAT 9 [FD 43 BK 43 PU RT 90 FD 26 LT 90 PD]
END

TO FARM.CROPS
  SETPC 6 SETPENSIZE 2
  FARM.MOVE 35 -155 SETXY 245 -155
  FARM.MOVE 35 -180 SETXY 245 -180
  SETPC 2
  FARM.MOVE 45 -155 SETH 0
  REPEAT 10 [
    FD 17 LT 45 FD 8 BK 8 RT 90 FD 8 BK 8 LT 45 BK 17
    PU RT 90 FD 21 LT 90 PD
  ]
  FARM.MOVE 45 -180 SETH 0
  REPEAT 10 [
    FD 12 LT 45 FD 6 BK 6 RT 90 FD 6 BK 6 LT 45 BK 12
    PU RT 90 FD 21 LT 90 PD
  ]
END

TO FARM
  CS WINDOW SETBG 15 HT
  SETPC 2 SETPENSIZE 2
  FARM.MOVE -280 -100 SETXY 280 -100
  FARM.SUN
  FARM.TREE 245 -85
  FARM.TREE 65 35
  FARM.BARN
  FARM.SILO
  FARM.TRACTOR
  FARM.FENCE
  FARM.CROPS
  PU HOME HT
END

FARM
