; ROCKET LAUNCH (animated companion to rocket.lgo)
; Load from Examples and press Run. Stop cancels the launch.
; WAIT uses Logo ticks: 60 ticks = one second.
; About 8 seconds: countdown, ignition, then accelerating liftoff.
; Run LAUNCH again to replay. The original ROCKET example is unchanged.

TO LAUNCH.MOVE :X :Y
  PU SETXY (:X / 2) ((:Y / 2) + :HEIGHT) PD
END

TO LAUNCH.LINE :X :Y
  SETXY (:X / 2) ((:Y / 2) + :HEIGHT)
END

TO LAUNCH.CIRCLE :X :Y :R
  LAUNCH.MOVE :X :Y SETH 0 ARC 360 (:R / 2)
END

TO LAUNCH.BACKDROP
  CLEAN
  SETPC 15 SETPENSIZE 2
  PU SETXY -170 130 PD FD 2
  PU SETXY 120 160 PD FD 2
  PU SETXY 160 80 PD FD 2
  PU SETXY -120 40 PD FD 2
  SETPC 8 SETPENSIZE 4
  PU SETXY -160 -170 PD SETXY 160 -170
  SETPC 7 SETPENSIZE 2
  PU SETXY -60 -165 PD SETXY 60 -165
END

TO LAUNCH.SHIP :HEIGHT :FLICKER
  ; Tall fuselage and pointed nose cone.
  SETPC 15 SETPENSIZE 3
  LAUNCH.MOVE -45 -75
  LAUNCH.LINE -45 90 LAUNCH.LINE 0 155 LAUNCH.LINE 45 90
  LAUNCH.LINE 45 -75 LAUNCH.LINE -45 -75
  SETPC 12
  LAUNCH.MOVE -45 90 LAUNCH.LINE 45 90
  LAUNCH.MOVE -33 108 LAUNCH.LINE 33 108
  LAUNCH.MOVE -22 124 LAUNCH.LINE 22 124

  ; Two circular windows with blue inner rims.
  SETPC 15
  LAUNCH.CIRCLE 0 55 21
  LAUNCH.CIRCLE 0 -4 17
  SETPC 11 SETPENSIZE 2
  LAUNCH.CIRCLE 0 55 15
  LAUNCH.CIRCLE 0 -4 11

  ; Swept fins on either side.
  SETPC 12 SETPENSIZE 3
  LAUNCH.MOVE -45 -15
  LAUNCH.LINE -85 -65 LAUNCH.LINE -85 -110 LAUNCH.LINE -45 -75
  LAUNCH.MOVE 45 -15
  LAUNCH.LINE 85 -65 LAUNCH.LINE 85 -110 LAUNCH.LINE 45 -75
  LAUNCH.MOVE -45 -45 LAUNCH.LINE -73 -80
  LAUNCH.MOVE 45 -45 LAUNCH.LINE 73 -80

  ; Engine nozzle and layered exhaust flame.
  SETPC 8
  LAUNCH.MOVE -28 -75
  LAUNCH.LINE -34 -95 LAUNCH.LINE 34 -95 LAUNCH.LINE 28 -75
  SETPC 12
  LAUNCH.MOVE -27 -98
  LAUNCH.LINE -38 -133 LAUNCH.LINE -19 -125 LAUNCH.LINE 0 (-180 - :FLICKER)
  LAUNCH.LINE 19 -125 LAUNCH.LINE 38 -133 LAUNCH.LINE 27 -98
  SETPC 14
  LAUNCH.MOVE -17 -100
  LAUNCH.LINE -20 -121 LAUNCH.LINE -9 -116 LAUNCH.LINE 0 (-152 - :FLICKER)
  LAUNCH.LINE 9 -116 LAUNCH.LINE 20 -121 LAUNCH.LINE 17 -100
  SETPC 15
  LAUNCH.MOVE -7 -102 LAUNCH.LINE 0 -131 LAUNCH.LINE 7 -102

  ; Small rivets along the body.
  SETPC 7 SETPENSIZE 2
  LAUNCH.MOVE -36 -58 SETH 0
  REPEAT 6 [FD 1 PU FD 10 PD]
  LAUNCH.MOVE 36 -58 SETH 0
  REPEAT 6 [FD 1 PU FD 10 PD]
END

TO LAUNCH
  CS WINDOW SETBG 0 HT SETH 0
  MAKE "COUNT 3
  REPEAT 3 [
    LAUNCH.BACKDROP
    LAUNCH.SHIP -100 0
    SETPC 14 SETPENSIZE 2
    PU SETXY -135 -110 LABEL :COUNT
    MAKE "COUNT :COUNT - 1
    WAIT 60
  ]
  MAKE "HEIGHT -100
  MAKE "SPEED 1
  MAKE "FLICKER 0
  REPEAT 70 [
    LAUNCH.BACKDROP
    LAUNCH.SHIP :HEIGHT :FLICKER
    MAKE "FLICKER 20 - :FLICKER
    MAKE "HEIGHT :HEIGHT + :SPEED
    MAKE "SPEED :SPEED + 0.12
    WAIT 4
  ]
  LAUNCH.BACKDROP
  SETPC 14 SETPENSIZE 2
  PU SETXY -100 0 LABEL [LIFTOFF!]
  PU HOME HT
END

LAUNCH
