; CAT WITH WHISKERS
; Load the complete file, then press Run. CAT redraws the whole picture.
; A sitting tabby with pointed ears, green eyes, whiskers, paws and a curled tail.

TO CAT.MOVE :X :Y
  PU SETXY :X :Y PD
END

TO CAT.OVAL :X :Y :RX :RY
  PU SETXY (:X + :RX) :Y PD
  MAKE "CAT.ANGLE 0
  REPEAT 72 [
    MAKE "CAT.ANGLE :CAT.ANGLE + 5
    SETXY (:X + :RX * COS :CAT.ANGLE) (:Y + :RY * SIN :CAT.ANGLE)
  ]
END

TO CAT.WHISKERS :SIDE
  CAT.MOVE (20 * :SIDE) 63 SETXY (108 * :SIDE) 84
  CAT.MOVE (22 * :SIDE) 56 SETXY (112 * :SIDE) 57
  CAT.MOVE (20 * :SIDE) 49 SETXY (105 * :SIDE) 32
END

TO CAT
  CS WINDOW SETBG 15 HT
  SETPC 6 SETPENSIZE 3
  ; Curled tail, behind the body.
  CAT.MOVE 44 -107
  SETXY 73 -108 SETXY 97 -91 SETXY 112 -65 SETXY 115 -38
  SETXY 106 -17 SETXY 88 -8 SETXY 70 -14 SETXY 64 -29
  SETXY 72 -42 SETXY 86 -44 SETXY 96 -35
  SETXY 87 -31 SETXY 81 -32 SETXY 80 -26 SETXY 88 -22
  SETXY 98 -29 SETXY 102 -43 SETXY 96 -65 SETXY 82 -84
  SETXY 65 -93 SETXY 50 -91
  ; Body and the outline of the head.
  CAT.OVAL 0 -55 54 72
  CAT.OVAL 0 70 65 53
  ; Pointed ears and pink inner ears.
  CAT.MOVE -58 94 SETXY -65 151 SETXY -25 119
  CAT.MOVE 58 94 SETXY 65 151 SETXY 25 119
  SETPC 12 SETPENSIZE 2
  CAT.MOVE -51 108 SETXY -55 134 SETXY -37 119
  CAT.MOVE 51 108 SETXY 55 134 SETXY 37 119
  ; Green eyes, slit pupils and a highlight.
  SETPC 2
  CAT.OVAL -24 78 12 15
  CAT.OVAL 24 78 12 15
  SETPC 0 SETPENSIZE 4
  CAT.MOVE -24 87 SETXY -24 68
  CAT.MOVE 24 87 SETXY 24 68
  SETPC 15 SETPENSIZE 2
  CAT.MOVE -27 83 SETXY -25 85
  CAT.MOVE 21 83 SETXY 23 85
  ; Pink triangular nose and a smiling mouth.
  SETPC 12 SETPENSIZE 3
  CAT.MOVE -7 58 SETXY 7 58 SETXY 0 50 SETXY -7 58
  SETPC 0 SETPENSIZE 2
  CAT.MOVE 0 50 SETXY 0 40
  SETXY -7 34 SETXY -15 36
  CAT.MOVE 0 40 SETXY 7 34 SETXY 15 36
  ; Three long whiskers on each cheek.
  CAT.WHISKERS -1
  CAT.WHISKERS 1
  ; Tabby forehead markings, chest and front legs.
  SETPC 6 SETPENSIZE 3
  CAT.MOVE -16 114 SETXY -12 99
  CAT.MOVE 0 119 SETXY 0 101
  CAT.MOVE 16 114 SETXY 12 99
  CAT.MOVE -18 6 SETXY 0 -13 SETXY 18 6
  CAT.MOVE -19 -45 SETXY -19 -108
  CAT.MOVE 19 -45 SETXY 19 -108
  CAT.MOVE -48 -30 SETXY -35 -35
  CAT.MOVE -53 -47 SETXY -39 -52
  CAT.MOVE 48 -30 SETXY 35 -35
  CAT.MOVE 53 -47 SETXY 39 -52
  ; Rounded paws and little toe marks.
  CAT.OVAL -28 -119 25 12
  CAT.OVAL 28 -119 25 12
  SETPENSIZE 2
  CAT.MOVE -38 -119 SETXY -38 -128
  CAT.MOVE -28 -120 SETXY -28 -130
  CAT.MOVE -18 -119 SETXY -18 -128
  CAT.MOVE 18 -119 SETXY 18 -128
  CAT.MOVE 28 -120 SETXY 28 -130
  CAT.MOVE 38 -119 SETXY 38 -128
  PU HOME HT
END

CAT
