; ROCKET SHIP
; Paste this entire file into the text editor and press Run.
; Use a graphics area at least 500 wide and 420 high.
; Run ROCKET again to redraw the scene.

TO ROCKET.MOVE :X :Y
  PU SETXY :X :Y PD
END

TO ROCKET.CIRCLE :X :Y :R
  ROCKET.MOVE :X :Y SETH 0 ARC 360 :R
END

TO ROCKET.STAR :X :Y :SIZE
  ROCKET.MOVE :X :Y SETH 90
  REPEAT 5 [FD :SIZE RT 144]
END

TO ROCKET
  CS WINDOW SETBG 0 HT
  ; Distant stars and a moon.
  SETPC 14 SETPENSIZE 2
  ROCKET.STAR -200 140 18
  ROCKET.STAR 125 155 14
  ROCKET.STAR -145 35 12
  ROCKET.STAR 175 -20 18
  ROCKET.STAR -210 -115 14
  ROCKET.STAR 130 -150 10
  SETPC 7 ROCKET.CIRCLE 180 90 28
  SETPC 8
  ROCKET.CIRCLE 169 99 7
  ROCKET.CIRCLE 188 80 9
  ROCKET.CIRCLE 189 103 4

  ; Tall fuselage and pointed nose cone.
  SETPC 15 SETPENSIZE 3
  ROCKET.MOVE -45 -75
  SETXY -45 90 SETXY 0 155 SETXY 45 90
  SETXY 45 -75 SETXY -45 -75
  SETPC 12
  ROCKET.MOVE -45 90 SETXY 45 90
  ROCKET.MOVE -33 108 SETXY 33 108
  ROCKET.MOVE -22 124 SETXY 22 124

  ; Two circular windows with blue inner rims.
  SETPC 15
  ROCKET.CIRCLE 0 55 21
  ROCKET.CIRCLE 0 -4 17
  SETPC 11 SETPENSIZE 2
  ROCKET.CIRCLE 0 55 15
  ROCKET.CIRCLE 0 -4 11

  ; Swept fins on either side.
  SETPC 12 SETPENSIZE 3
  ROCKET.MOVE -45 -15
  SETXY -85 -65 SETXY -85 -110 SETXY -45 -75
  ROCKET.MOVE 45 -15
  SETXY 85 -65 SETXY 85 -110 SETXY 45 -75
  ROCKET.MOVE -45 -45 SETXY -73 -80
  ROCKET.MOVE 45 -45 SETXY 73 -80

  ; Engine nozzle and layered exhaust flame.
  SETPC 8
  ROCKET.MOVE -28 -75
  SETXY -34 -95 SETXY 34 -95 SETXY 28 -75
  SETPC 12
  ROCKET.MOVE -27 -98
  SETXY -38 -133 SETXY -19 -125 SETXY 0 -190
  SETXY 19 -125 SETXY 38 -133 SETXY 27 -98
  SETPC 14
  ROCKET.MOVE -17 -100
  SETXY -20 -121 SETXY -9 -116 SETXY 0 -162
  SETXY 9 -116 SETXY 20 -121 SETXY 17 -100
  SETPC 15
  ROCKET.MOVE -7 -102 SETXY 0 -131 SETXY 7 -102

  ; Small rivets along the body.
  SETPC 7 SETPENSIZE 2
  ROCKET.MOVE -36 -58 SETH 0
  REPEAT 6 [FD 2 PU FD 20 PD]
  ROCKET.MOVE 36 -58 SETH 0
  REPEAT 6 [FD 2 PU FD 20 PD]
  PU HOME HT
END

ROCKET
