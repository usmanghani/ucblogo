# All optional, all server-side. Never prefix these with VITE_.

# Which model teaches. A plain id is served by Vercel AI Gateway.
# PIP_MODEL=deepseek/deepseek-v4.1-flash

# Local development: lets the agent reach AI Gateway from your machine.
# `npx eve link` writes VERCEL_OIDC_TOKEN for you; an API key also works.
# AI_GATEWAY_API_KEY=

# Use any OpenAI-compatible endpoint instead of AI Gateway (a local model, another router).
# PIP_MODEL_BASE_URL=http://localhost:11434/v1
# PIP_MODEL_API_KEY=

# Accounts (optional). Without both of these the site is anonymous-only. See docs/accounts.md.
# On Vercel, adding Neon from the Marketplace sets DATABASE_URL for you.
# DATABASE_URL=postgres://...
# BETTER_AUTH_SECRET=   # openssl rand -base64 32
