{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.agent.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2024", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* The agent shares the Logo engine and the course with the page, and eve bundles it. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["agent"]
}
