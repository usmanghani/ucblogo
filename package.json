{
  "name": "ucblogo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/unit.xml && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke-assistant.mjs",
    "predev": "node scripts/prepare-monaco.mjs",
    "prebuild": "node scripts/prepare-build.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vercel/firewall": "1.2.5",
    "blockly": "^13.3.0",
    "monaco-editor": "0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
