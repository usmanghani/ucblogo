{
  "name": "logo-teacher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-monaco.mjs && vite",
    "build": "npm run build:web",
    "build:web": "node scripts/prepare-build.mjs && tsc -b && vite build",
    "build:agent": "eve build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/unit.xml && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke-teacher.mjs",
    "dev:db": "node e2e/test-db.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@assistant-ui/react": "^0.15.33",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/firewall": "1.2.5",
    "ai": "^7.0.166",
    "better-auth": "^1.7.20",
    "eve": "^1.0.0-rc.7",
    "monaco-editor": "0.56.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "just-bash": "^3.6.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
