; FISH file

TO MOVE :SIZE :FAR
HT
SETPC 1
FISH :SIZE
CLEAN
PU
FD :FAR
PD
MOVE :SIZE :FAR
END

TO VEE :SIZE
LT 135
FD :SIZE
BK :SIZE
LT 90
FD :SIZE
BK :SIZE
LT 135
END

TO ARCR90 :SIZE
REPEAT 5 [FD :SIZE RT 18]
END

TO FISH :SIZE
REPEAT 2 [ARCR90 :SIZE RT 90]
RT 45 VEE :SIZE * 2
LT 45
END

; GALAXY file

TO GALAXY :SIDE :ANGLE
PU
FD :SIDE
PD
FD 1
RT :ANGLE
GALAXY :SIDE + 5 :ANGLE
END

; GALAXY2 file

TO GALAXY :SIDE :ANGLE
    PU
    FD :SIDE
    PD
    FD 1
    RT :ANGLE
;   make "side :SIDE * 1.5
    make "side :SIDE + 1
;   make "side :SIDE + 5
    GALAXY :SIDE :ANGLE
END

