TO BIOSPHERE
    CS FS SETWIDTH 1 MAKE "D 0 MAKE "G 0
    LABEL "ONESTEP
    MAKE "G :G+1 IF :G > 16000 [STOP]
    IF :D > 200 [PU]
    PD FD RANDOM 6 LT RANDOM 45 FD RANDOM 6 RT RANDOM 40
    MAKE "D DISTANCE [0 0]
    IF :D > 300 [PU SETH TOWARDS [0 0] FD RANDOM 30 RT RANDOM 60 LT RANDOM 60 PD]
    GO "ONESTEP
END
