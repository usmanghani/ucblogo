TO BIOSQUARE
    CS FS SETWIDTH 1 MAKE "G 0
    LABEL "ONESTEP
    MAKE "G :G + 1 IF :G > 16000 [STOP]
    GOHOME FD RANDOM 6 LT RANDOM 45 FD RANDOM 6 RT RANDOM 40
    SETPC RANDOM 16 PD (STAMPOVAL 10 10 "TRUE) PU
    GO "ONESTEP
END

TO GOHOME
    IF OR (XCOR > 300) (YCOR > 250) SETH TOWARDS [0 0]
    IF OR (XCOR < -300) (YCOR < -250) SETH TOWARDS [0 0]
END
